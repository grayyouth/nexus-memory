{
  "version": "0.9.5",
  "store": {
    "base_dir": "E:\\VSCodeProjects\\Nexus\\nexus_store",
    "description": "Path to nexus_store directory. null = default (./nexus_store relative to project root)."
  },
  "ingestion": {
    "max_chunk_chars": 1200,
    "description": "Maximum characters per chunk. Friendly to small-context local LLMs."
  },
  "watchkeeper": {
    "default_interval": 3600,
    "auto_start": false,
    "description": "Default scan interval in seconds. auto_start = start on Nexus init."
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "token": "",
    "mode": "direct",
    "auto_start": false,
    "autoclose_minutes": 360,
    "autoclose_interval_min": 30
  },
  "summarizer": {
    "max_items_per_bucket": 10,
    "max_item_chars": 300,
    "max_dialog_messages": 5,
    "description": "Limits for auto-generated session summaries."
  },
  "compressor": {
    "default_level": 1,
    "max_done": 8,
    "max_decisions": 6,
    "max_next": 6,
    "max_other": 4,
    "max_dialog_messages": 6,
    "max_dialog_chars": 220,
    "max_chars": 2400
  },
  "digest": {
    "max_sessions_per_agent": 6,
    "max_items_per_bucket": 4,
    "max_item_chars": 300,
    "max_decisions": 8,
    "max_chunks": 8,
    "chunk_preview_chars": 140
  },
  "semantic": {
    "vector_size": 512,
    "cache_size": 128,
    "use_sentence_transformers": false,
    "description": "Semantic search settings. sentence_transformers gives better results but requires pip install."
  },
  "ocr": {
    "default_engine": null,
    "default_languages": [
      "eng",
      "rus"
    ],
    "description": "OCR settings. null = auto-select best available engine."
  },
  "trust": {
    "trusted_domains": [
      "wikipedia.org",
      "python.org",
      "mozilla.org",
      "microsoft.com",
      "arxiv.org",
      "github.com",
      "oracle.com",
      "redhat.com"
    ],
    "trusted_trust": 1.0,
    "unknown_url_trust": 0.4,
    "local_doc_trust": 0.8,
    "default_trust": 0.5,
    "trust_weight": 0.25,
    "description": "Source-trust scoring (core/trust.py). trust_weight damps semantic scores: score *= (1 - w + w*trust)."
  },
  "prompt_templates": {
    "context_prompt_max_chunks": 5,
    "context_prompt_max_chars": 1800,
    "description": "Default limits for build_context_prompt."
  }
}
